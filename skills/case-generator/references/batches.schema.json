{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "batches.json 分批状态契约 schema 1.0",
  "description": "case-generator/batch.py 的状态文件。分批单元为模块或一级功能点；状态机 pending -> doing -> done；gate 取 pass/fail/waived。规则与集成方案 §8 一致。",
  "type": "object",
  "required": ["schema_version", "requirement_fingerprint", "batches", "current"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "requirement_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1},
    "split_reason": {"type": "string", "description": "触发分批的判定依据（条数/模块数）"},
    "estimated_total": {"type": "integer", "minimum": 0, "description": "评审阶段预估总条数（OM4 plan_vs_actual 对账基线；旧文件可缺省）"},
    "batches": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "module_code", "feature_ids", "status", "gate", "case_ids", "started_at", "finished_at"],
        "additionalProperties": false,
        "properties": {
          "unit_id": {"type": "string", "pattern": "^M\\d{2}(-FP-\\d{2,})?$", "description": "批次唯一键：模块批为 M01；单模块超限续拆的子批为 M01-FP-03"},
          "module_code": {"type": "string", "pattern": "^M\\d{2}$"},
          "feature_ids": {"type": "array", "items": {"type": "string", "pattern": "^FP-\\d{2,}$"}, "minItems": 1, "description": "该批覆盖的可生成功能点"},
          "status": {"enum": ["pending", "doing", "done"]},
          "gate": {"enum": ["pass", "fail", "waived", "not_run"]},
          "case_ids": {"type": "array", "items": {"type": "string", "pattern": "^TC-[A-Z0-9]{2,8}-\\d{3}$"}},
          "started_at": {"type": ["string", "null"]},
          "finished_at": {"type": ["string", "null"]},
          "gate_report": {"type": ["string", "null"], "description": "该批门禁报告文件名"}
        }
      }
    },
    "current": {"type": ["string", "null"], "description": "当前批 module_code，全部完成时为 null"}
  }
}